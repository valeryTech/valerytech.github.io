{
  "identity": {
    "human": "SSO + MFA",
    "workload": "OIDC federation",
    "long_lived_keys": "rotation-required",
    "break_glass": "disabled"
  },
  "rotation": {
    "default_days": 30,
    "database_days": 7,
    "workload_identity_minutes": 60,
    "automatic_rotation_enabled": false
  },
  "data_classification": [
    "public",
    "internal",
    "restricted"
  ],
  "policies": [
    "deny-public-datastores",
    "deny-cross-environment-routing",
    "require-encryption",
    "require-owner",
    "require-credential-rotation",
    "require-change-approval"
  ],
  "aws_example_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Deny",
        "Action": "*",
        "Resource": "*"
      }
    ]
  },
  "gcp_example_policy": {
    "bindings": []
  },
  "azure_example_role_assignments": []
}
