{{- $pages := where site.Pages "Params.exclude_search" "!=" true -}}
{{- $index := slice -}}
{{- range $id, $page := $pages -}}
  {{/* The theme inserts summaries as HTML. Keep previews short and escaped,
       while retaining the complete article text for full-text search. */}}
  {{- $summary := $page.Description | default $page.Summary | plainify | htmlUnescape -}}
  {{- $summary = $summary | replaceRE `\s+` " " | strings.TrimSpace | truncate 179 "…" | htmlUnescape | htmlEscape -}}
  {{- $index = $index | append (dict
    "id" $id
    "title" $page.Title
    "permalink" $page.RelPermalink
    "tags" ($page.Params.tags | default slice)
    "content" $page.Plain
    "summary" $summary
    "date" (time.Format (site.Params.searchDateFormat | default "2006-01-02") $page.Date)
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
