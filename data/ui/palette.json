{
  "cookie": {
    "name": "palette-preferences",
    "maxAgeSeconds": 31536000
  },
  "presetsStorageKey": "site-palette-presets",
  "maxSavedPresets": 12,
  "title": "Color palette",
  "description": "Changes apply to the theme in view. Switch Light or Dark in the header to edit the other.",
  "groups": [
    {
      "title": "Text",
      "tokens": [
        {
          "token": "page-background",
          "label": "Page background"
        },
        {
          "token": "foreground",
          "label": "Main text",
          "contrast": { "against": "page-background", "minimum": 4.5 }
        },
        {
          "token": "body-foreground",
          "label": "Body text",
          "contrast": { "against": "page-background", "minimum": 4.5 }
        },
        {
          "token": "heading-foreground",
          "label": "Headings",
          "contrast": { "against": "page-background", "minimum": 4.5 }
        },
        {
          "token": "muted",
          "label": "Secondary text",
          "contrast": { "against": "page-background", "minimum": 4.5 }
        },
        {
          "token": "link-color",
          "label": "Links and selection",
          "contrast": { "against": "page-background", "minimum": 4.5 }
        },
        {
          "token": "accent",
          "label": "Focus and control accent",
          "contrast": { "against": "nav-selected-surface", "minimum": 4.5 }
        }
      ]
    },
    {
      "title": "Navigation",
      "tokens": [
        {
          "token": "context-foreground",
          "label": "Navigation labels and breadcrumbs",
          "contrast": { "against": "context-header", "minimum": 4.5 }
        },
        {
          "token": "context-header",
          "label": "Navigation bars"
        },
        {
          "token": "context-surface",
          "label": "Navigation parents"
        },
        {
          "token": "nav-foreground",
          "label": "Menu text",
          "contrast": { "against": "page-background", "minimum": 4.5 }
        },
        {
          "token": "nav-selected-surface",
          "label": "Current section"
        }
      ]
    },
    {
      "title": "Surfaces",
      "tokens": [
        {
          "token": "panel",
          "label": "Panels"
        },
        {
          "token": "card-surface",
          "label": "Cards"
        },
        {
          "token": "card-hover",
          "label": "Hover surfaces"
        },
        {
          "token": "code-surface",
          "label": "Code blocks"
        },
        {
          "token": "border",
          "label": "Borders"
        },
        {
          "token": "table-header",
          "label": "Table header"
        },
        {
          "token": "table-surface",
          "label": "Table body"
        }
      ]
    }
  ],
  "presets": [
    {
      "id": "site",
      "label": "Site colors",
      "light": {},
      "dark": {}
    },
    {
