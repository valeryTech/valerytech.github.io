  "presetLabel": "Preset",
  "customLabel": "Custom colors",
  "sitePresetsLabel": "Site presets",
  "savedPresetsLabel": "Saved in this browser",
  "presetNameLabel": "Palette name",
  "saveLabel": "Save",
  "deleteLabel": "Delete",
  "resetLabel": "Reset this theme",
  "copyLabel": "Copy CSS",
