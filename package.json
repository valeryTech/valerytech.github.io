{
  "name": "valery-tech",
  "version": "0.0.1",
  "description": "Working notes on software, AI systems, cognition, and human-agent systems",
  "author": "Valery Judah",
  "license": "MIT",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "create": "hugo new",
    "predev": "node scripts/site-map.mjs",
    "dev": "hugo server --disableFastRender --noHTTPCache --renderToMemory --baseURL=http://localhost:1313/",
    "format": "prettier **/** -w -c",
    "lint": "npm run lint:descriptions",
    "lint:descriptions": "HUGOxPARAMSxSEOxDESCRIPTIONxLENGTHxERRORLEVEL=error hugo --environment production --renderToMemory --noBuildLock --logLevel error",
    "prebuild": "node scripts/site-map.mjs",
    "build": "hugo --minify --gc --cleanDestinationDir",
    "maps": "node scripts/site-map.mjs",
    "test:analytics": "node --test tests/analytics/*.test.mjs",
    "test:seo": "node --test tests/seo/*.test.mjs",
    "test:site-map": "node --test tests/site-map/*.test.mjs",
    "test:redirects": "node --test tests/redirects/*.test.mjs",
    "test:theme": "node --test tests/theme/*.test.mjs",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "posthog-js": "^1.434.15",
    "flexsearch": "0.8.143",
    "katex": "0.16.25",
    "@fontsource/jost": "^5.2.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
